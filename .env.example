# Optional. Defaults to the repository-local, Git-ignored data/ directory.
INTERNSHIP_AGENT_DATA_DIR=

# Optional. Dashboard profile when no profile cookie is set: "demo" or "real" (default real).
INTERNSHIP_AGENT_DEFAULT_PROFILE=

# Optional. Set to "generated" to send the generated resume variant instead of your uploaded resume.
INTERNSHIP_AGENT_RESUME_SOURCE=

# Optional. owner/repository used by `pnpm verify:github:real` when --repo is not given.
INTERNSHIP_AGENT_GITHUB_REPOSITORY=

# Optional. Used only by local browser verification.
INTERNSHIP_AGENT_BASE_URL=http://127.0.0.1:3100

# Optional. Application runs open a visible browser window by default.
# Set to 1 to run headless (more likely to trip site bot detection).
# Handshake sign-in always uses a visible window.
HEADLESS=

# Optional. Postings fully fetched per GitHub job-list check (1-100, default 100).
# The listed-link scan (5x), posting requests (1.5x), and time limit (4.5 s each) scale with it.
INTERNSHIP_AGENT_DISCOVERY_MAX_POSTINGS=
# Optional. Wall-clock time (ms) a `pnpm pipeline:run` or watcher pass gives discovery to analyze and prepare
# new postings and start public-board checks (60000-21600000, default 900000 = 15 minutes). Postings and boards
# past it wait for the next pass, oldest first; the pass always goes on to its application step.
INTERNSHIP_AGENT_DISCOVERY_BUDGET_MS=

# Optional. Discovery and `pnpm pipeline:run` prepare every QUALIFIED posting at or
# above this fit score (0-100, default 0).
INTERNSHIP_AGENT_PREPARE_MIN_FIT=

# Optional. Set to 1 to let `pnpm pipeline:run` start a browser run for each verified
# package without a package approval. Runs fill the form and stop at the submit
# approval unless INTERNSHIP_AGENT_AUTO_SUBMIT below submits a clean run. Sign-in pages and pages
# without a form stop the run once and leave the package for the candidate.
INTERNSHIP_AGENT_AUTO_APPLY=
# Pursue only postings for this term (season-year), software or adjacent roles, in the US.
INTERNSHIP_AGENT_TARGET_TERM=
# 1 submits clean on-target runs without you (needs AUTO_APPLY=1 and a target term; manual mode wins).
INTERNSHIP_AGENT_AUTO_SUBMIT=
# Lowest current AI fit for an automatic submission (default 50, 40-100; a moderate score at or above it may be sent).
INTERNSHIP_AGENT_AUTO_SUBMIT_MIN_FIT=
# Automatic submissions per day (default 10, 1-50). Set unlimited to remove the daily cap. Per-company limits still apply.
INTERNSHIP_AGENT_AUTO_SUBMIT_DAILY_CAP=
# Import only GitHub list rows listed within this many days (undated rows are skipped while set).
INTERNSHIP_AGENT_DISCOVERY_MAX_AGE_DAYS=
# Most automatic applications per company per target term: runs the pipeline started, in flight or submitted (default 2).
INTERNSHIP_AGENT_COMPANY_CAP=

# Optional. With AUTO_APPLY=1 (manual mode off), automatic runs create a Workday candidate account
# with this email on Workday sites you have no session for, and sign in with it later. It must equal
# the profile email. Each Workday tenant gets its own random password, saved outside the repository
# with owner-only permissions; `pnpm workday:account --site <host>` prints one site's entry.
# CAPTCHAs and unexpected steps hold the run for you; nothing is solved or bypassed.
INTERNSHIP_AGENT_WORKDAY_ACCOUNT_EMAIL=
# Optional. The accounts file (default ~/.config/internship-agent/<profile>/workday-accounts.json;
# required when INTERNSHIP_AGENT_DATA_DIR is set).
INTERNSHIP_AGENT_WORKDAY_ACCOUNTS_FILE=
# Optional. Gmail address and a Gmail app password (not the account password), read over IMAP in
# read-only mode to open Workday's (and iCIMS's) account verification emails. Nothing is deleted, moved or sent.
# Also read by `pnpm mail:watch` to DM interview, assessment, offer and rejection emails about your applications.
INTERNSHIP_AGENT_GMAIL_ADDRESS=
INTERNSHIP_AGENT_GMAIL_APP_PASSWORD=

# Optional. Set to 1 to let the agent accept data-processing, data-retention, and privacy-policy
# consent that is a condition of applying (a "has my consent to retain my data" box, Jobvite's
# Data Consent step with the residence matching your profile country, iCIMS's email-step consent).
# Each acceptance is logged on the timeline with the exact text. Marketing, newsletter, and
# job-alert opt-ins are never accepted. Manual checklist mode turns it off.
# Accepted statements do not hold an automatic submission (your opt-in).
INTERNSHIP_AGENT_ACCEPT_DATA_CONSENT=
# Optional. Set to 1 to let the agent sign application attestations whose truth does not depend on
# an unknown fact: accuracy certifications, electronic signatures (your saved legal first and last
# name and today's date), acknowledgments (at-will, privacy or applicant notice, temporary
# internship, equal-opportunity statement), and background-check, drug-test, reference-check, and
# arbitration authorizations, each logged with its text. Statements of fact (citizenship, U.S.
# person or export control, clearance, debarment, criminal history, prior employment, non-compete)
# still come only from your saved answers. Manual checklist mode turns it off.
# Accepted statements do not hold an automatic submission (your opt-in).
INTERNSHIP_AGENT_SIGN_ATTESTATIONS=
# Optional. Set to 1 (with AUTO_APPLY=1, manual mode off) to let automatic runs take iCIMS's
# email-first account step: create an iCIMS account with the account email below, or sign in with
# its saved password. Each iCIMS host gets its own random password, saved outside the repository
# with owner-only permissions. CAPTCHAs, an existing account with no saved password, and
# unexpected screens hold the run; nothing is solved or bypassed. The agent then stops at iCIMS's
# application (it does not fill iCIMS forms yet). `pnpm icims:account --site <host>` prints one
# host's entry; `--clear-hold` lets the next pass retry it.
INTERNSHIP_AGENT_ICIMS_ACCOUNTS=
# Optional. The account email for iCIMS accounts (falls back to INTERNSHIP_AGENT_WORKDAY_ACCOUNT_EMAIL).
# It must equal the profile email.
INTERNSHIP_AGENT_ACCOUNT_EMAIL=
# Optional. The iCIMS accounts file (default ~/.config/internship-agent/<profile>/icims-accounts.json;
# required when INTERNSHIP_AGENT_DATA_DIR is set).
INTERNSHIP_AGENT_ICIMS_ACCOUNTS_FILE=

# Optional. A Discord DM after each pipeline pass listing what is new: held runs with the
# questions to answer, sent applications, stopped runs, and errors (company, title, question
# text, and reasons only). Off unless both are set. The bot must share a server with you.
# `pnpm notify:test` sends one test DM.
INTERNSHIP_AGENT_DISCORD_BOT_TOKEN=
INTERNSHIP_AGENT_DISCORD_USER_ID=

# Optional. Set to 1 to hide the AI submission flow (package approval, browser runs,
# submit approvals) and use the Review Queue as a manual checklist instead.
# Nothing is removed; unset to restore the AI flow.
INTERNSHIP_AGENT_MANUAL_ONLY=

# Optional. Run traces (kept only when a browser run stops, pauses, or fails) record the
# screencast film strip and the actions. Set to 1 to add a screenshot before and after each
# action when debugging one site (much slower and larger; still no cookies, headers, or DOM).
INTERNSHIP_AGENT_TRACE_SNAPSHOTS=
# Optional. Comma-separated host names; when set, the setting above applies only on these hosts.
INTERNSHIP_AGENT_TRACE_SNAPSHOT_HOSTS=

# Optional. Model drafting of open-ended application answers in the candidate's voice.
# Needs MODEL_API_* above, the local corpus (`pnpm voice:import`, stored Git-ignored under
# data/profiles/<profile>/voice unless INTERNSHIP_AGENT_VOICE_DIR is set), and this
# mandatory local detector gate (absolute path to local-ai-detector/voice-gate).
# Drafts send the candidate's writing samples and profile material to the configured model.
VOICE_GATE_COMMAND=
INTERNSHIP_AGENT_VOICE_DIR=

# Optional. Set to 0 to turn off the AI review of a run's open questions (on when MODEL_API_* is set);
# it sends the questions, the posting, and saved standard facts (sensitive ones only as "saved").
INTERNSHIP_AGENT_PAUSE_REVIEW=

# Heavy verification gates (agent:finish, harness browser suites) allowed at once on this machine (default 2, 1-32).
INTERNSHIP_AGENT_GATE_SLOTS=

# Optional. Used only for GitHub API read requests and higher rate limits.
GITHUB_TOKEN=

# Optional. Explicit posting-corpus acceptance reads this directory.
# Defaults to the Git-ignored data/job-postings/.
INTERNSHIP_AGENT_POSTING_CORPUS=

# Default model for model-backed features and explicit live-model tests.
# Optional: without a key, requirement classification stays deterministic.
# Live tests against this low-cost model are approved unless the user opts out.
# Use only synthetic or public, non-sensitive inputs: contributor-tier requests
# may be used by Meta to improve its products.
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_API_MODEL=muse-spark-1.3-contributor

# The configured model's published limits. Every model call in a process shares one
# limiter that runs at 90% of both (evenly spaced starts, output budget reserved up front)
# and retries 429 responses after Retry-After or exponential backoff.
MODEL_REQUESTS_PER_MINUTE=100
MODEL_TOKENS_PER_MINUTE=3000000

# Optional. Postings whose model classification runs at once during discovery (1-64,
# default 32); the limiter above, not this number, enforces the provider's limits.
INTERNSHIP_AGENT_MODEL_CONCURRENCY=

# Optional user-supplied price snapshot for the configured model, USD per million tokens.
# When absent, analytics reports AI cost as unknown rather than zero.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=

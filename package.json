{
  "name": "internship-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev --filter=@internship-agent/dashboard",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "turbo test",
    "seed:dev": "tsx packages/db/scripts/seed-dev.ts",
    "seed:browser": "tsx packages/db/scripts/seed-browser.ts",
    "pipeline:run": "tsx --env-file-if-exists=.env packages/agent/scripts/run-pipeline.ts",
    "pipeline:watch": "tsx --env-file-if-exists=.env packages/agent/scripts/pipeline-watch.ts",
    "pipeline:status": "tsx --env-file-if-exists=.env packages/agent/scripts/pipeline-status.ts",
    "discovery:trace": "tsx --env-file-if-exists=.env packages/agent/scripts/discovery-trace.ts",
    "pipeline:audit": "tsx --env-file-if-exists=.env packages/agent/scripts/pipeline-audit.ts",
    "pipeline:schedule": "tsx --env-file-if-exists=.env packages/agent/scripts/schedule-pipeline.ts",
    "pipeline:retry": "tsx --env-file-if-exists=.env packages/agent/scripts/pipeline-retry.ts",
    "workday:account": "tsx --env-file-if-exists=.env packages/agent/scripts/workday-account.ts",
    "icims:account": "tsx --env-file-if-exists=.env packages/agent/scripts/icims-account.ts",
    "notify:test": "tsx --env-file-if-exists=.env packages/agent/scripts/notify-test.ts",
    "discord:read": "tsx --env-file-if-exists=.env packages/agent/scripts/discord-read.ts",
    "digest:preview": "tsx --env-file-if-exists=.env packages/agent/scripts/digest-preview.ts",
    "mail:watch": "tsx --env-file-if-exists=.env packages/agent/scripts/mail-watch.ts",
    "mail:scan": "tsx --env-file-if-exists=.env packages/agent/scripts/mail-scan.ts",
    "mail:schedule": "tsx --env-file-if-exists=.env packages/agent/scripts/schedule-mail.ts",
    "backfill:extraction": "tsx packages/agent/scripts/backfill-extraction.ts",
    "labels:hold-fallback": "tsx packages/agent/scripts/hold-fallback-labels.ts",
    "application:record": "tsx --env-file-if-exists=.env packages/agent/scripts/application-record.ts",
    "fit:intent": "tsx --env-file-if-exists=.env packages/agent/scripts/application-intent.ts",
    "voice:import": "tsx --env-file-if-exists=.env packages/agent/scripts/import-voice.ts",
    "profile:facts": "tsx --env-file-if-exists=.env packages/agent/scripts/profile-facts.ts",
    "run:answer": "tsx --env-file-if-exists=.env packages/agent/scripts/run-answer.ts",

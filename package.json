    "run:evidence": "tsx --env-file-if-exists=.env packages/agent/scripts/run-evidence.ts",
    "profile:answers": "tsx --env-file-if-exists=.env packages/agent/scripts/profile-answers.ts",
    "profile:coursework": "tsx --env-file-if-exists=.env packages/agent/scripts/profile-coursework.ts",
    "profile:resume": "tsx --env-file-if-exists=.env packages/agent/scripts/profile-resume.ts",
    "agent:doctor": "node testing-harness/agent-doctor.mjs",
    "agent:verify": "node testing-harness/run.mjs --changed",
    "agent:finish": "node testing-harness/agent-finish.mjs",
    "verify:fast": "node testing-harness/run.mjs --tier fast",
    "verify:local": "node testing-harness/run.mjs --tier local",
    "verify:browser": "node testing-harness/run.mjs --tier browser",
    "verify:feature": "node testing-harness/run.mjs --feature",
    "verify:github:real": "tsx testing-harness/github/real-repository.acceptance.ts",
    "verify:jobs:corpus": "tsx --env-file-if-exists=.env testing-harness/jobs/posting-corpus.acceptance.ts",
    "corpus:build": "node testing-harness/jobs/build-corpus.mjs",
    "public:sync": "node scripts/public-sync.mjs",
    "test:domain": "pnpm --filter @internship-agent/domain test",
    "test:agent": "pnpm --filter @internship-agent/agent test:mapper",
    "test:agent:doorbell": "pnpm --filter @internship-agent/agent test:doorbell",
    "test:agent:pass": "pnpm --filter @internship-agent/agent test:pass",
    "test:agent:labels": "pnpm --filter @internship-agent/agent test:labels",
    "test:agent:company": "pnpm --filter @internship-agent/agent test:company",
    "test:agent:pursuit": "pnpm --filter @internship-agent/agent test:pursuit",
    "test:agent:retry": "pnpm --filter @internship-agent/agent test:retry",
    "test:agent:continued": "pnpm --filter @internship-agent/agent test:continued",
    "test:agent:evidence": "pnpm --filter @internship-agent/agent test:evidence",
    "test:agent:security-code": "pnpm --filter @internship-agent/agent test:security-code",
    "test:agent:oracle-code": "pnpm --filter @internship-agent/agent test:oracle-code",
    "test:agent:workday-account": "pnpm --filter @internship-agent/agent test:workday-account",
    "test:agent:workday-account:local": "pnpm --filter @internship-agent/agent test:workday-account:local",
    "test:agent:icims-account": "pnpm --filter @internship-agent/agent test:icims-account",
    "test:agent:notify": "pnpm --filter @internship-agent/agent test:notify",
    "test:agent:discord-read": "pnpm --filter @internship-agent/agent test:discord-read",
    "test:agent:digest": "pnpm --filter @internship-agent/agent test:digest",
    "test:agent:record": "pnpm --filter @internship-agent/agent test:record",
    "test:agent:record:chromium": "pnpm --filter @internship-agent/agent test:record:chromium",
    "test:agent:mail": "pnpm --filter @internship-agent/agent test:mail",
    "test:agent:mail:local": "pnpm --filter @internship-agent/agent test:mail:local",
    "test:memory": "pnpm --filter @internship-agent/agent test:memory",
    "test:agent:profile-facts": "pnpm --filter @internship-agent/agent test:profile-facts",
    "test:agent:answers": "pnpm --filter @internship-agent/agent test:answers",
    "test:agent:answers:local": "pnpm --filter @internship-agent/agent test:answers:local",
    "test:agent:profile-coursework": "pnpm --filter @internship-agent/agent test:profile-coursework",
    "test:agent:profile-resume": "pnpm --filter @internship-agent/agent test:profile-resume",
    "test:db": "pnpm --filter @internship-agent/db test",
    "test:github": "pnpm --filter @internship-agent/github test",
    "test:github:fast": "pnpm --filter @internship-agent/github test:fast",
    "test:github:local": "pnpm --filter @internship-agent/github test:local",
    "test:jobs": "pnpm --filter @internship-agent/jobs test",
    "test:jobs:fast": "pnpm --filter @internship-agent/jobs test:fast",
    "test:jobs:local": "pnpm --filter @internship-agent/jobs test:local",
    "test:matching": "pnpm --filter @internship-agent/matching test",
    "test:matching:fast": "pnpm --filter @internship-agent/matching test:fast",
    "test:matching:local": "pnpm --filter @internship-agent/matching test:local",
    "test:writer": "pnpm --filter @internship-agent/writer test",
    "test:writer:fast": "pnpm --filter @internship-agent/writer test:fast",
    "test:writer:local": "pnpm --filter @internship-agent/writer test:local",
    "test:verifier": "pnpm --filter @internship-agent/verifier test",
    "test:verifier:local": "pnpm --filter @internship-agent/verifier test:local",
    "test:browser-worker": "pnpm --filter @internship-agent/browser test",
    "test:voice:fast": "pnpm --filter @internship-agent/voice test:fast",
    "test:browser-worker:fast": "pnpm --filter @internship-agent/browser test:fast",
    "test:browser-worker:local": "pnpm --filter @internship-agent/browser test:local",
    "test:browser-worker:oracle": "pnpm --filter @internship-agent/browser test:oracle:local",
    "test:outcomes:fast": "vitest --root . run testing-harness/outcomes/outcome-contracts.test.ts",
    "test:outcomes:local": "vitest --root . run testing-harness/outcomes/funnel.integration.test.ts",
    "test:dashboard:fast": "vitest --root . run testing-harness/dashboard/style-contracts.test.ts",
    "test:browser:fixture": "tsx testing-harness/browser/fixture-run.ts",
    "test:browser:workday-account": "tsx testing-harness/browser/workday-account-run.ts",
    "test:browser:account-consent": "tsx testing-harness/browser/account-consent-run.ts",
    "test:browser:greenhouse": "tsx testing-harness/browser/greenhouse-fixture-run.ts",
    "test:browser:greenhouse-demographics": "tsx testing-harness/browser/greenhouse-demographics-run.ts",
    "test:browser:unrecognized-forms": "tsx testing-harness/browser/unrecognized-forms-run.ts",
    "test:browser:site-navigation": "tsx testing-harness/browser/site-navigation-run.ts",
    "test:browser:oracle-apply": "tsx testing-harness/browser/oracle-apply-run.ts",
    "test:harness": "node --test testing-harness/harness/*.test.mjs",
    "test:browser": "node testing-harness/browser/run.mjs",
    "verify:fit:model": "tsx --env-file-if-exists=.env testing-harness/matching/semantic-fit-model.acceptance.ts"
  },
  "devDependencies": {
    "@internship-agent/agent": "workspace:*",
    "@internship-agent/browser": "workspace:*",
    "@internship-agent/db": "workspace:*",
    "@internship-agent/domain": "workspace:*",
    "@internship-agent/github": "workspace:*",
    "@internship-agent/jobs": "workspace:*",
    "@internship-agent/matching": "workspace:*",
    "@internship-agent/resume": "workspace:*",
    "@internship-agent/verifier": "workspace:*",
    "@internship-agent/voice": "workspace:*",
    "@internship-agent/writer": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.20.6",
    "turbo": "^2.5.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
